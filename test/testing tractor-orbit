/* =========================================================
   FSB MODEL
   ========================================================= */

.fsb-model {
    position: relative;

    width:
        clamp(
            300px,
            68vw,
            920px
        );

    height:
        clamp(
            300px,
            68vw,
            920px
        );

    max-width: 100%;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: center;

    isolation: isolate;

    overflow: visible;
}


/* =========================================================
   INNER FSB IMAGE
   ========================================================= */

.fsb-inner {
    position: absolute;

    inset: 8%;

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 5;

    pointer-events: none;
}


.fsb-inner-image {
    display: block;

    width: 100%;
    height: 100%;

    max-width: none;

    object-fit: contain;

    object-position: center;

    filter:
        drop-shadow(
            0 25px 45px rgba(0,0,0,0.30)
        );

    animation:
        fsbInnerFloat 7s ease-in-out infinite;
}


@keyframes fsbInnerFloat {

    0%,
    100% {
        transform:
            translateY(0)
            scale(1);
    }

    50% {
        transform:
            translateY(-8px)
            scale(1.015);
    }
}


/* =========================================================
   FSB MODEL PULSE
   ========================================================= */

.fsb-model-pulse {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 28%;
    aspect-ratio: 1;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    z-index: 2;

    pointer-events: none;

    background:
        radial-gradient(
            circle,
            rgba(174, 231, 84, 0.24),
            rgba(0, 180, 91, 0.10) 35%,
            transparent 72%
        );

    filter: blur(5px);

    animation:
        fsbPulse 3.5s ease-in-out infinite;
}


@keyframes fsbPulse {

    0%,
    100% {
        opacity: 0.35;
        transform: translate(-50%, -50%) scale(0.9);
    }

    50% {
        opacity: 0.8;
        transform: translate(-50%, -50%) scale(1.15);
    }
}


/* =========================================================
   TRACTOR ORBIT
   ========================================================= */

.tractor-orbit {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 15;

    pointer-events: none;

    overflow: visible;

    animation:
        tractorOrbitRotation 32s linear infinite;

    transform-origin: center center;
}


@keyframes tractorOrbitRotation {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}


/* =========================================================
   TRACTOR NODE
   ========================================================= */

.tractor-node {
    position: absolute;

    left: 50%;
    top: 50%;

    width:
        clamp(
            32px,
            4.2vw,
            65px
        );

    height:
        clamp(
            32px,
            4.2vw,
            65px
        );

    margin:
        calc(
            -1 *
            clamp(
                16px,
                2.1vw,
                32.5px
            )
        );

    display: flex;
    align-items: center;
    justify-content: center;

    transform:
        rotate(var(--angle))
        translateY(
            calc(
                -1 *
                clamp(
                    145px,
                    29vw,
                    395px
                )
            )
        )
        rotate(calc(-1 * var(--angle)));

    transform-origin: center center;
}


/* =========================================================
   TRACTOR IMAGE
   ========================================================= */

.tractor-node img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    filter:
        drop-shadow(
            0 5px 8px rgba(0,0,0,0.45)
        );

    animation:
        tractorFloat 2.4s ease-in-out infinite;

    opacity: 1;

    visibility: visible;
}


@keyframes tractorFloat {

    0%,
    100% {
        transform: translateY(0) scale(1);
    }

    50% {
        transform: translateY(-4px) scale(1.06);
    }
}


/* =========================================================
   ALTERNATING TRACTOR ANIMATION
   ========================================================= */

.tractor-node:nth-child(3n) img {
    animation-delay: -0.8s;
}

.tractor-node:nth-child(3n + 1) img {
    animation-delay: -1.5s;
}

.tractor-node:nth-child(3n + 2) img {
    animation-delay: -2.1s;
}